# UniFi Controller Configuration
UNIFI_BASE_URL=https://192.168.1.1
UNIFI_API_KEY=your_unifi_api_key_here
ACCEPT_INVALID_CERTS=true

# Proxy Server Settings
LISTEN_ADDR=0.0.0.0:8080

# Optional Proxy Client Authentication (Set to enforce token check for proxy clients)
# PROXY_AUTH_TOKEN=your_secret_proxy_client_token

# Granular Permission Scopes (Homey-style zero-trust defaults)
# Enable only the specific domains and actions required for your use case.
SCOPE_INFO_READ=true
SCOPE_SITES_READ=true
SCOPE_DEVICES_READ=true
SCOPE_DEVICES_CONTROL=false
SCOPE_DEVICES_ADOPT=false
SCOPE_CLIENTS_READ=true
SCOPE_CLIENTS_CONTROL=false
SCOPE_WLAN_READ=false
SCOPE_PROTECT_READ=false
